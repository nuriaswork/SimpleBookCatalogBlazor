@page "/add-new"
@inject IBookRepository Repository 
@inject NavigationManager Navigation

@* we need to register IBookRepository in Program.cs *@
@* if we move the usings to _Imports.razor, we can use it in multiple places *@


<PageTitle>Add New Book</PageTitle>

<div class="row justify-content-center">
    <div class="col-6">
        <BookForm IsEditMode="false" OnValidBookSubmit="AddBook" />
    </div>

</div>

@code {

    private async Task AddBook(Book book)
    {
        await Repository.AddAsync(book);
        Navigation.NavigateTo("/");
    }
}
