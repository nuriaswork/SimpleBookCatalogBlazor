@page "/edit/{id:int}"
@inject IBookRepository Repository
@inject NavigationManager Navigation

@* input parameter id is case insensitive. We'll refer to it uppercase for match Book.Id property *@

<PageTitle>Edit Book</PageTitle>

<div class="row justify-content-center">
    <div class="col-6">
        <BookForm IsEditMode="true" BookId="@Id" OnValidBookSubmit="UpdateBook" />
    </div>

</div>


@code {

    [Parameter]
    public int Id { get; set; }

    private async Task UpdateBook(Book book)
    {
        await Repository.UpdateAsync(book);
        Navigation.NavigateTo("/");
    }
}
