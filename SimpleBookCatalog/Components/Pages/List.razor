@page "/" 
@inject IBookRepository Repository

@*
@rendermode InteractiveServer
Without this rendermode, ConfirmDeleteDialog won't show up, because by default Blazor uses Static Server Rendering (no interactivity)
InteractiveServer makes the whole page (including components) interactive using Interactive Server Rendering via the Blazor Server Hosting Model
BUT: we can apply it just in the component that needs it
*@

@* 
@attribute [StreamRendering]  
this makes possible that book can be null, otherwise, the page doesn't render until books is populated
*@

<PageTitle>Book List</PageTitle>

<div class="row justify-content-center">
    <div class="col-6">
        <a href="add-new" class="btn btn-primary shadow-none mb-3">Add New</a>
        @if (books is null)
        {
            <div class="book-item">Loading books. Please, wait... </div>
        }
        else if (books.Any())
        {
            @foreach (var book in books)
            {
                <div class="book-item">
                    <BookCard @rendermode="InteractiveServer" Book="book" />
                </div>
            }
        }
        else
        {
            <div class="book-item">No books found.</div>
        }
    </div>
</div>

@code {

    private List<Book>? books;

    protected override async Task OnInitializedAsync()
    {
        //lets simulate a slow network (to use with @attribute [StreamRendering])
        // await Task.Delay(3000);

        books = await Repository.GetAllAsync();
    }
}
